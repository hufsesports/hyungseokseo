---
interface Props { title: string; title2?: string; sub?: string; tagline?: string; image?: string; compact?: boolean }
const { title, title2, sub, tagline, image = '/hero.webp', compact = false } = Astro.props;
---
<section class:list={['hero', { compact }]} style={`--img:url(${image})`}>
  <div class="box">
    <h1>{title}{title2 && <span class="l2">{title2}</span>}</h1>
    {sub && <p class="sub">{sub}</p>}
  </div>
  {tagline && <p class="tagline">{tagline}</p>}
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-height: 380px;
    padding: var(--space-4) var(--space-3);
    background:
      linear-gradient(rgba(16, 26, 38, 0.78), rgba(16, 26, 38, 0.78)),
      var(--img) center / cover no-repeat;
    color: #fff;
    text-align: center;
  }
  .hero.compact { min-height: 260px; }
  .box {
    max-width: 920px;
    width: 100%;
  }
  h1 {
    margin: 0;
    font-size: clamp(1.3rem, 5.6vw, 3rem);
    font-weight: 400;
    letter-spacing: -0.01em;
    line-height: 1.2;
  }
  .l2 { display: block; }
  .sub { margin: 0.5rem 0 0; font-size: 1.05rem; color: #d8dde3; }
  .tagline { margin: 0; font-size: 1.05rem; font-style: italic; color: #e9edf1; }
  @media (max-width: 760px) {
    .hero { min-height: 300px; }
  }
</style>
