---
import Base from '../../layouts/Base.astro';
import Band from '../../components/Band.astro';
import Hero from '../../components/Hero.astro';
import { course as c } from '../../data/pte101';
---
<Base current="T1A PTE" title="T1A PTE 101 — Seo Hyung Seok" description={c.intro}>
  <Hero title={c.title} sub={c.sub} compact />

  <Band title="Course">
    <p class="center">{c.intro}</p>
    <p class="center muted">{c.meta}</p>
  </Band>

  <Band title="Assignments">
    <div class="cols-3 asg">
      {c.assignments.map((a) => (
        <article class:list={{ off: !a.open }}>
          <p class="no">{a.name}</p>
          <h3>{a.title}</h3>
          <p class="due">{a.due}</p>
          {a.open ? <a class="go" href={a.href}>과제 작성하기 →</a> : <span class="soon">준비 중</span>}
        </article>
      ))}
    </div>
  </Band>

  <Band title="12 Weeks">
    <table class="wk">
      <tbody>
        {c.weeks.map((w) => (
          <tr class:list={{ sp: w.topic.startsWith('특강') }}>
            <th>{w.w}</th>
            <td class="d">{w.date}</td>
            <td>{w.topic}</td>
            <td class="n">{w.note}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </Band>
</Base>

<style>
  .center { text-align: center; max-width: 760px; margin: 0 auto 1rem; }
  .muted { color: var(--muted); font-size: 0.95rem; }
  .asg article { border-top: 3px solid var(--navy); padding-top: 1rem; }
  .asg article.off { border-top-color: var(--line); color: var(--muted); }
  .asg .no { margin: 0; color: var(--navy); font-weight: 700; font-size: 0.9rem; }
  .asg .off .no { color: var(--muted); }
  .asg h3 { margin: 0.2rem 0 0.4rem; font-size: 1.1rem; }
  .asg .due { margin: 0 0 1rem; font-size: 0.9rem; color: var(--muted); }
  .go { color: var(--navy); font-weight: 600; font-size: 0.95rem; text-decoration: none; border-bottom: 1px solid currentColor; }
  .soon { font-size: 0.9rem; }
  .wk { width: 100%; max-width: 820px; margin: 0 auto; border-collapse: collapse; font-size: 0.95rem; }
  .wk th, .wk td { padding: 0.65rem 0.6rem; border-bottom: 1px solid var(--line); text-align: left; vertical-align: top; }
  .wk th { width: 4.2rem; color: var(--navy); white-space: nowrap; }
  .wk .d { width: 4rem; color: var(--muted); }
  .wk .n { color: var(--muted); font-size: 0.88rem; text-align: right; }
  .wk tr.sp td:nth-child(3) { color: var(--navy); }
  @media (max-width: 760px) { .wk .n { display: none; } }
</style>
