---
import Base from '../layouts/Base.astro';
import Band from './Band.astro';
import Hero from './Hero.astro';
import Journey from './Journey.astro';
import { hero, intro, career, focus, links } from '../data/site';
---
<Base current="Home">
  <Hero title={hero.tagline} sub={hero.sub} />

  <Band title="Introduction" id="introduction">
    <div class="cols-2 prose">
      <div lang="en">{intro.en.map((p) => <p set:html={p} />)}</div>
      <div lang="ko">{intro.ko.map((p) => <p set:html={p} />)}</div>
    </div>
  </Band>

  <Band title="Career" id="career">
    <div class="cols-2">
      <ul class="sq" lang="en">{career.en.map((c) => <li>{c}</li>)}</ul>
      <ul class="sq" lang="ko">{career.ko.map((c) => <li>{c}</li>)}</ul>
    </div>
  </Band>

  <Band title="Research" id="research">
    <div class="lead">
      <p class="headline">{focus.headline}</p>
      <p class="subline">{focus.sub}</p>
    </div>
    <div class="cols-3 focus">
      {focus.items.map((f) => (
        <div class="item">
          <h3>{f.title}</h3>
          <p class="ko">{f.ko}</p>
          <ul class="sq">{f.bullets.map((b) => <li>{b}</li>)}</ul>
          <a class="more" href={f.href}>Learn more →</a>
        </div>
      ))}
    </div>
  </Band>

  <Band title="Journey" id="journey">
    <p class="center muted">Selected moments across coaching, league operations, strategy, education, and international standardization.</p>
    <Journey />
  </Band>

  <Band title="Contact" id="contact">
    <div class="cols-2">
      <div>
        <h3 class="h3">Email</h3>
        <p class="kv">
          <a href={`mailto:${links.emailWork}`}>{links.emailWork}</a><br />
          <a href={`mailto:${links.emailPersonal}`}>{links.emailPersonal}</a>
        </p>
        <p class="muted small">Open to research collaboration, speaking, and industry advisory.<br />연구 협업, 강연, 산업 자문 문의를 받습니다.</p>
      </div>
      <div>
        <h3 class="h3">Links</h3>
        <ul class="sq">
          <li><a href={links.scholar} target="_blank" rel="noopener">Google Scholar</a></li>
          <li><a href={links.hufs} target="_blank" rel="noopener">HUFS Faculty Profile · 교수 프로필</a></li>
          <li><a href={links.instagram} target="_blank" rel="noopener">Instagram @seo.hyeongseok</a></li>
        </ul>
      </div>
    </div>
  </Band>
</Base>

<style>
  .prose p { margin: 0 0 1rem; }
  .prose :global(b) { font-weight: 700; }
  .center { text-align: center; }
  .muted { color: var(--muted); }
  .small { font-size: 0.9rem; }

  .lead { text-align: center; margin-bottom: var(--space-4); }
  .headline { margin: 0 0 0.75rem; font-size: 1.15rem; font-weight: 700; }
  .subline { margin: 0; font-size: 1.15rem; font-style: italic; }

  .focus .item { display: flex; flex-direction: column; }
  .focus h3 { margin: 0; text-align: center; font-size: 1.2rem; font-weight: 600; }
  .focus .ko { margin: 0 0 1.25rem; text-align: center; color: var(--navy); font-weight: 500; }
  .focus .sq { flex: 1; }
  .more {
    margin-top: 1.25rem;
    align-self: center;
    color: var(--navy);
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    border-bottom: 1px solid currentColor;
  }

  .h3 { margin: 0 0 0.5rem; font-size: 1.1rem; font-weight: 700; color: var(--navy); }
  .kv { margin: 0 0 1rem; }
  .kv a, .sq a { color: var(--fg); text-underline-offset: 3px; }
</style>
