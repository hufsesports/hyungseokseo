---
import Base from '../../../layouts/Base.astro';
import Hero from '../../../components/Hero.astro';
import { parts, COMP, LEVELS, ACTIONS, PERIODS, endpoint } from '../../../data/pte101';

const pad = (i: number) => String(i + 1).padStart(2, '0');

// 코드북: key → 문항·선택지 (응답 시트, Word 양식과 같은 코드)
const book: Record<string, { part: string; q: string; type: string; n?: number; values: Record<string, string>; req: number }> = {};
for (const p of parts) {
  for (const it of p.questions) {
    if ('special' in it) {
      if (it.special === 'comp') {
        for (const [code, label] of [['Q12', '현재 수준'], ['Q13', '목표 직무 요구 수준']]) {
          for (const c of COMP) book[`${code}.${c.key}`] = { part: p.no, q: `${label} – ${c.name}`, type: 'single', values: Object.fromEntries([1, 2, 3, 4, 5].map((v) => [String(v), String(v)])), req: 1 };
        }
      } else {
        for (const pr of PERIODS) book[`Q16.${pr.key}`] = { part: p.no, q: `실행 계획 – ${pr.name}`, type: 'multi', values: Object.fromEntries(ACTIONS.map((a, i) => [pad(i), a])), req: 1 };
      }
    } else {
      book[it.code] = { part: p.no, q: it.q, type: it.type, n: it.n, values: Object.fromEntries((it.opts ?? []).map((o, i) => [pad(i), o])), req: it.optional ? 0 : 1 };
    }
  }
}
const rule = (t: string, n?: number) => ({ single: '1개 선택', multi: '복수 선택', multiN: `${n}개 선택`, text: '' } as Record<string, string>)[t];
---
<Base current="T1A PTE" title="웰컴과제 — T1A PTE 101" description="나의 e스포츠 커리어 맵 & 역량 로드맵">
  <Hero title="웰컴과제" sub="나의 e스포츠 커리어 맵 & 역량 로드맵" compact />

  <div class="wrap intro">
    <p><a href="/pte101/" class="back">← T1A PTE 101</a></p>
    <ul class="info">
      <li><b>제출</b> 11/28(토) 23:59</li>
      <li><b>소요</b> 약 10분 · 대부분 클릭으로 선택</li>
      <li><b>저장</b> 작성 중인 내용은 이 브라우저에 자동 저장됩니다</li>
      <li><b>수정</b> 다시 제출하면 마지막 제출 기준으로 봅니다</li>
    </ul>
    <p class="muted">정답은 없습니다. 지금 내가 어디에 있고, 어디로 가고 싶고, 무엇이 부족한지 솔직하게 선택하세요. 제출하면 나의 커리어 맵 요약이 바로 만들어지고, 2주차 수업과 10주차 기말 포트폴리오에서 다시 사용합니다.</p>
  </div>

  <form id="f" class="wrap" novalidate>
    {parts.map((p) => (
      <section class="part">
        <h2><span class="pn">{p.no}</span>{p.title}{p.en && <small>{p.en}</small>}</h2>
        {p.questions.map((it) => {
          if ('special' in it && it.special === 'comp') return (
            <div class="q" data-keys={['Q12', 'Q13'].flatMap((c) => COMP.map((x) => `${c}.${x.key}`)).join(',')}>
              <p class="qt"><span class="code">Q12·Q13</span>역량별 현재 수준과 목표 직무가 요구하는 수준</p>
              <p class="hint">1 {LEVELS[0]} · 2 {LEVELS[1]} · 3 {LEVELS[2]} · 4 {LEVELS[3]} · 5 {LEVELS[4]}</p>
              <div class="comp">
                {COMP.map((c) => (
                  <div class:list={['ci', { evt: c.key === 'EVT' }]} data-key={c.key}>
                    <div class="cn"><b>{c.name}</b><span>{c.desc}</span></div>
                    {[['Q12', '현재'], ['Q13', '요구']].map(([code, lab]) => (
                      <div class="scale" data-q={`${code}.${c.key}`}>
                        <span class="sl">{lab}</span>
                        {[1, 2, 3, 4, 5].map((v) => (
                          <label class="pill num"><input type="radio" name={`${code}.${c.key}`} value={String(v)} /><span>{v}</span></label>
                        ))}
                      </div>
                    ))}
                  </div>
                ))}
              </div>
              <p class="err" />
            </div>
          );
          if ('special' in it) return (
            <div class="q" data-keys={PERIODS.map((p) => `Q16.${p.key}`).join(',')}>
              <p class="qt"><span class="code">Q16</span>기간별로 할 일을 모두 고르세요</p>
              {PERIODS.map((pr) => (
                <div class="period" data-q={`Q16.${pr.key}`}>
                  <p class="pt">{pr.name}{pr.hint && <small>{pr.hint}</small>}</p>
                  <div class="opts">
                    {ACTIONS.map((a, i) => (
                      <label class="pill"><input type="checkbox" name={`Q16.${pr.key}`} value={pad(i)} /><span>{a}</span></label>
                    ))}
                  </div>
                </div>
              ))}
              <p class="err" />
            </div>
          );
          const q = it;
          return (
            <div class="q" data-keys={q.code} data-q={q.code}>
              <p class="qt"><span class="code">{q.code === 'NAME' ? '' : q.code}</span>{q.q}{rule(q.type, q.n) && <small>{rule(q.type, q.n)}</small>}</p>
              {q.hint && <p class="hint">{q.hint}</p>}
              {q.type === 'text'
                ? <input class="txt" type={q.code === 'Q10' ? 'url' : 'text'} name={q.code} placeholder={q.placeholder} maxlength="300" autocomplete={q.code === 'NAME' ? 'name' : 'off'} />
                : <div class="opts">
                    {q.opts!.map((o, i) => (
                      <label class="pill"><input type={q.type === 'single' ? 'radio' : 'checkbox'} name={q.code} value={pad(i)} /><span>{o}</span></label>
                    ))}
                  </div>}
              <p class="err" />
            </div>
          );
        })}
      </section>
    ))}

    <section class="part submit">
      <h2><span class="pn">제출</span></h2>
      <div class="q" data-q="CODE">
        <p class="qt">수업 코드<small>수업 시간에 안내한 코드</small></p>
        <input class="txt short" type="text" name="CLASS_CODE" autocomplete="off" />
        <p class="err" />
      </div>
      <input type="text" name="website" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
      <button type="submit" id="go" disabled={!endpoint}>{endpoint ? '제출하기' : '제출 준비 중'}</button>
      <p id="msg" class="msg" role="status"></p>
    </section>
  </form>

  <div class="progress" id="prog"><div class="wrap"><span id="pc">0 / 0</span><i><b id="pb"></b></i></div></div>

  <section id="result" class="wrap" hidden>
    <div class="card">
      <p class="rk">T1A PTE 101 · 웰컴과제</p>
      <h2 id="r-name"></h2>
      <p id="r-goal" class="goal"></p>
      <div class="rgrid">
        <div>
          <h3>커리어 맵</h3>
          <dl id="r-map"></dl>
          <h3>강점</h3>
          <p id="r-str"></p>
        </div>
        <div>
          <h3>역량 진단 <small><i class="lg cur"></i>현재 <i class="lg req"></i>요구</small></h3>
          <svg id="r-radar" viewBox="0 0 440 290" role="img" aria-label="역량 레이더 차트"></svg>
          <p id="r-gap" class="small"></p>
        </div>
      </div>
      <h3>역량 로드맵</h3>
      <dl id="r-road" class="road"></dl>
      <p class="small"><b>PTE 핵심 결과물</b> <span id="r-out"></span></p>
    </div>
    <p class="ra"><button type="button" id="print">PDF로 저장 · 인쇄</button> <button type="button" id="edit" class="ghost">응답 수정하기</button></p>
  </section>

  <script type="application/json" id="book" set:html={JSON.stringify({ book, endpoint, comp: COMP })} />
</Base>

<script>
  type Entry = { part: string; q: string; type: string; n?: number; values: Record<string, string>; req: number };
  const { book, endpoint, comp } = JSON.parse(document.getElementById('book')!.textContent!) as {
    book: Record<string, Entry>; endpoint: string; comp: { key: string; name: string }[];
  };
  const KEYS = Object.keys(book);
  const STORE = 'pte101-welcome-v1';
  const f = document.getElementById('f') as HTMLFormElement;
  const $ = (id: string) => document.getElementById(id)!;

  const read = (): Record<string, string[]> => {
    const a: Record<string, string[]> = {};
    for (const k of KEYS) a[k] = [];
    for (const el of Array.from(f.elements) as HTMLInputElement[]) {
      if (!el.name || !(el.name in a)) continue;
      if ((el.type === 'checkbox' || el.type === 'radio')) { if (el.checked) a[el.name].push(el.value); }
      else if (el.value.trim()) a[el.name] = [el.value.trim()];
    }
    return a;
  };
  const label = (k: string, v: string) => (book[k].type === 'text' ? v : book[k].values[v] ?? v);

  const problem = (k: string, a: Record<string, string[]>): string => {
    const e = book[k]; const n = a[k].length;
    if (!e.req) return '';
    if (e.type === 'text') return n ? (k === 'Q10' && !/^https?:\/\/\S+\.\S+/.test(a[k][0]) ? 'http로 시작하는 링크를 붙여 주세요.' : '') : '입력해 주세요.';
    if (e.type === 'single') return n === 1 ? '' : '하나를 선택해 주세요.';
    if (e.type === 'multiN') return n === e.n ? '' : `${e.n}개를 골라 주세요. (현재 ${n}개)`;
    return n ? '' : '하나 이상 선택해 주세요.';
  };
  const pairIssue = (a: Record<string, string[]>, k1: string, k2: string) => {
    const x = a[k1][0], y = a[k2][0];
    return x && y && x === y && book[k1].values[x] !== '아직 모름' ? '1지망과 2지망을 다르게 골라 주세요.' : '';
  };

  const validate = (show: boolean) => {
    const a = read();
    let done = 0, first: HTMLElement | null = null;
    for (const box of Array.from(f.querySelectorAll<HTMLElement>('.q[data-keys]'))) {
      const keys = box.dataset.keys!.split(',');
      let msg = '';
      for (const k of keys) { const m = problem(k, a); if (m) { msg = keys.length > 1 ? '모든 항목을 선택해 주세요.' : m; break; } }
      if (!msg && keys[0] === 'Q6') msg = pairIssue(a, 'Q5', 'Q6');
      if (!msg && keys[0] === 'Q8') msg = pairIssue(a, 'Q7', 'Q8');
      if (!msg && keys[0].startsWith('Q16')) { const p = keys.find((k) => !a[k].length); if (p) msg = '단기·중기·장기 모두 하나 이상 골라 주세요.'; }
      if (!msg) done++;
      box.classList.toggle('bad', show && !!msg);
      (box.querySelector('.err') as HTMLElement).textContent = show ? msg : '';
      if (show && msg && !first) first = box;
    }
    const total = f.querySelectorAll('.q[data-keys]').length;
    $('pc').textContent = `${done} / ${total}`;
    ($('pb') as HTMLElement).style.width = `${(done / total) * 100}%`;
    return { a, ok: done === total, first };
  };

  // 개수 제한 (n개 선택 문항)
  f.addEventListener('change', (ev) => {
    const el = ev.target as HTMLInputElement;
    const e = book[el.name];
    if (e?.type === 'multiN' && el.checked) {
      const on = f.querySelectorAll<HTMLInputElement>(`input[name="${el.name}"]:checked`);
      if (on.length > e.n!) { el.checked = false; const box = el.closest('.q') as HTMLElement; box.querySelector('.err')!.textContent = `최대 ${e.n}개까지 고를 수 있어요.`; }
    }
    save(); validate(f.classList.contains('tried'));
  });
  f.addEventListener('input', () => { save(); validate(f.classList.contains('tried')); });

  // 임시 저장
  function save() {
    try {
      const d: Record<string, string[]> = {};
      for (const el of Array.from(f.elements) as HTMLInputElement[]) {
        if (!el.name || el.name === 'website') continue;
        if (el.type === 'checkbox' || el.type === 'radio') { if (el.checked) (d[el.name] ||= []).push(el.value); }
        else if (el.value) d[el.name] = [el.value];
      }
      localStorage.setItem(STORE, JSON.stringify(d));
    } catch {}
  }
  try {
    const d = JSON.parse(localStorage.getItem(STORE) || '{}') as Record<string, string[]>;
    for (const el of Array.from(f.elements) as HTMLInputElement[]) {
      const v = d[el.name]; if (!v) continue;
      if (el.type === 'checkbox' || el.type === 'radio') el.checked = v.includes(el.value); else el.value = v[0];
    }
  } catch {}
  validate(false);

  const uid = () => (crypto.randomUUID ? crypto.randomUUID() : `${Date.now()}-${Math.random().toString(16).slice(2)}`);

  f.addEventListener('submit', async (ev) => {
    ev.preventDefault();
    f.classList.add('tried');
    const { a, ok, first } = validate(true);
    const code = (f.elements.namedItem('CLASS_CODE') as HTMLInputElement).value.trim();
    const codeBox = f.querySelector('[data-q="CODE"]') as HTMLElement;
    codeBox.querySelector('.err')!.textContent = code ? '' : '수업 코드를 입력해 주세요.';
    if (!ok || !code) { (first || codeBox).scrollIntoView({ behavior: 'smooth', block: 'center' }); return; }
    if (!endpoint) return;

    const wide: Record<string, string | number> = {};
    const long: { part: string; key: string; q: string; value: string; label: string }[] = [];
    for (const k of KEYS) {
      wide[k] = a[k].map((v) => label(k, v)).join('; ');
      for (const v of a[k]) long.push({ part: book[k].part, key: k, q: book[k].q, value: book[k].type === 'text' ? '' : v, label: label(k, v) });
    }
    for (const c of comp) wide[`GAP.${c.key}`] = Number(a[`Q13.${c.key}`][0]) - Number(a[`Q12.${c.key}`][0]);
    const cut = KEYS.indexOf('Q13.GLB') + 1;
    const columns = [...KEYS.slice(0, cut), ...comp.map((c) => `GAP.${c.key}`), ...KEYS.slice(cut)];
    const payload = { id: uid(), classCode: code, website: (f.elements.namedItem('website') as HTMLInputElement).value, columns, wide, long };

    const btn = $('go') as HTMLButtonElement; const msg = $('msg');
    btn.disabled = true; msg.textContent = '제출 중…'; msg.className = 'msg';
    try {
      let res: { ok: boolean; error?: string };
      try {
        const r = await fetch(endpoint, { method: 'POST', body: JSON.stringify(payload) });
        res = await r.json();
      } catch {
        // 응답을 읽지 못하는 환경: 같은 id로 한 번 더 보내고(서버에서 중복 제거) 성공으로 처리
        await fetch(endpoint, { method: 'POST', mode: 'no-cors', body: JSON.stringify(payload) });
        res = { ok: true };
      }
      if (!res.ok) { msg.textContent = res.error || '제출하지 못했습니다.'; msg.className = 'msg bad'; return; }
      msg.textContent = '';
      showResult(a);
    } catch (e) {
      msg.textContent = (e as Error).message + ' 잠시 후 다시 시도해 주세요.'; msg.className = 'msg bad';
    } finally { btn.disabled = false; }
  });

  // ── 결과 카드 ──
  function showResult(a: Record<string, string[]>) {
    const L = (k: string) => a[k].map((v) => label(k, v)).join(', ');
    $('r-name').textContent = `${a.NAME[0]}의 e스포츠 커리어 맵`;
    $('r-goal').textContent = `“${a.Q9[0]}”`;
    $('r-map').innerHTML = '';
    for (const [t, v] of [['1지망', `${L('Q5')} · ${L('Q7')}`], ['2지망', `${L('Q6')} · ${L('Q8')}`], ['공고 요건', L('Q11')]]) {
      const dt = document.createElement('dt'); dt.textContent = t; const dd = document.createElement('dd'); dd.textContent = v; $('r-map').append(dt, dd);
    }
    $('r-str').textContent = L('Q4');
    const gaps = comp.map((c) => ({ ...c, g: Number(a[`Q13.${c.key}`][0]) - Number(a[`Q12.${c.key}`][0]) })).sort((x, y) => y.g - x.g);
    $('r-gap').textContent = `격차가 큰 역량: ${gaps.slice(0, 2).map((x) => `${x.name}(+${x.g})`).join(', ')} · 먼저 보완할 역량: ${L('Q14')}`;
    radar(comp.map((c) => Number(a[`Q12.${c.key}`][0])), comp.map((c) => Number(a[`Q13.${c.key}`][0])), comp.map((c) => c.name));
    $('r-road').innerHTML = '';
    for (const [k, t] of [['Q16.S', '단기 · PTE 12주'], ['Q16.M', '중기 · 1년'], ['Q16.L', '장기 · 3~5년']]) {
      const dt = document.createElement('dt'); dt.textContent = t; const dd = document.createElement('dd'); dd.textContent = L(k); $('r-road').append(dt, dd);
    }
    $('r-out').textContent = a.Q17[0];
    f.hidden = true; $('prog').hidden = true; document.querySelector('.intro')!.setAttribute('hidden', '');
    $('result').hidden = false; $('result').scrollIntoView({ behavior: 'smooth' });
  }
  function radar(cur: number[], req: number[], names: string[]) {
    const cx = 220, cy = 145, R = 100, n = names.length, NS = 'http://www.w3.org/2000/svg';
    const pt = (i: number, v: number) => { const ang = -Math.PI / 2 + (2 * Math.PI * i) / n; return [cx + Math.cos(ang) * R * v / 5, cy + Math.sin(ang) * R * v / 5]; };
    const svg = $('r-radar'); svg.innerHTML = '';
    const el = (tag: string, at: Record<string, string>) => { const e = document.createElementNS(NS, tag); for (const k in at) e.setAttribute(k, at[k]); svg.append(e); return e; };
    for (let lv = 1; lv <= 5; lv++) el('polygon', { points: names.map((_, i) => pt(i, lv).join(',')).join(' '), class: 'grid' });
    names.forEach((nm, i) => {
      const [x, y] = pt(i, 5); el('line', { x1: String(cx), y1: String(cy), x2: String(x), y2: String(y), class: 'grid' });
      const [tx, ty] = pt(i, 6.1); const t = el('text', { x: String(tx), y: String(ty + 4), 'text-anchor': Math.abs(tx - cx) < 5 ? 'middle' : tx > cx ? 'start' : 'end', class: 'lab' }); t.textContent = nm;
    });
    el('polygon', { points: req.map((v, i) => pt(i, v).join(',')).join(' '), class: 'req' });
    el('polygon', { points: cur.map((v, i) => pt(i, v).join(',')).join(' '), class: 'cur' });
  }
  $('print').addEventListener('click', () => window.print());
  $('edit').addEventListener('click', () => { f.hidden = false; $('prog').hidden = false; document.querySelector('.intro')!.removeAttribute('hidden'); $('result').hidden = true; window.scrollTo({ top: 0 }); });
</script>

<style>
  .intro { padding-top: var(--space-3); }
  .back { color: var(--navy); font-size: 0.9rem; text-decoration: none; }
  .info { list-style: none; padding: 0; margin: 0.5rem 0 1rem; display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.3rem 2rem; font-size: 0.95rem; }
  .info b { color: var(--navy); margin-right: 0.5rem; }
  .muted { color: var(--muted); font-size: 0.95rem; }

  .part { margin-top: var(--space-4); }
  .part h2 { margin: 0 0 1rem; padding-bottom: 0.6rem; border-bottom: 2px solid var(--navy); font-size: 1.35rem; color: var(--fg); }
  .pn { color: var(--navy); margin-right: 0.7rem; }
  .part h2 small { margin-left: 0.7rem; font-size: 0.85rem; font-weight: 400; color: var(--muted); }
  .q { padding: 1.1rem 0; border-bottom: 1px solid var(--line); }
  .qt { margin: 0 0 0.6rem; font-weight: 700; }
  .qt small { margin-left: 0.6rem; font-weight: 400; color: var(--muted); font-size: 0.85rem; }
  .code { color: var(--navy); font-size: 0.8rem; margin-right: 0.5rem; }
  .code:empty { display: none; }
  .hint { margin: -0.3rem 0 0.7rem; color: var(--muted); font-size: 0.88rem; }
  .err { margin: 0.4rem 0 0; color: #c8102e; font-size: 0.88rem; min-height: 0; }
  .err:empty { display: none; }
  .q.bad .qt { color: #c8102e; }

  .opts { display: flex; flex-wrap: wrap; gap: 0.45rem; }
  .pill { position: relative; cursor: pointer; }
  .pill input { position: absolute; opacity: 0; inset: 0; margin: 0; cursor: pointer; }
  .pill span { display: inline-block; padding: 0.4rem 0.85rem; border: 1px solid #c9ced4; border-radius: 999px; font-size: 0.92rem; line-height: 1.4; background: #fff; transition: background 0.12s, color 0.12s, border-color 0.12s; }
  .pill:hover span { border-color: var(--navy); }
  .pill input:checked + span { background: var(--navy); border-color: var(--navy); color: #fff; }
  .pill input:focus-visible + span { outline: 2px solid var(--navy); outline-offset: 2px; }
  .pill.num span { width: 2.3rem; padding: 0.35rem 0; text-align: center; }

  .txt { width: 100%; padding: 0.65rem 0.8rem; border: 1px solid #c9ced4; border-radius: 6px; font: inherit; font-size: 0.95rem; background: #fffdf3; }
  .txt:focus { outline: 2px solid var(--navy); border-color: var(--navy); }
  .txt.short { max-width: 240px; }
