---
import '../styles/global.css';
import { links, meta, nav } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  /** 현재 메뉴 (nav의 label) */
  current?: string;
}

const { title, description, current = 'Home' } = Astro.props;
const pageTitle = title ?? meta.title;
const pageDesc = description ?? meta.description;
const site = Astro.site?.origin ?? 'https://hyungseokseo.com';
const canonical = new URL(Astro.url.pathname, site).href;

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Seo Hyung Seok',
  alternateName: ['Henry Seo', '서형석', 'Hyungseok Seo'],
  url: site,
  jobTitle: 'Adjunct Professor',
  affiliation: { '@type': 'CollegeOrUniversity', name: 'Hankuk University of Foreign Studies' },
  email: links.emailWork,
  sameAs: [links.scholar, links.hufs, links.instagram],
  knowsAbout: ['Esports', 'Esports governance', 'Tournament operations', 'Sports industry'],
};
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/hero.webp', site).href} />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" />
    <script type="application/ld+json" set:html={JSON.stringify(person)} />
  </head>
  <body>
    <header class="bar">
      <div class="wrap bar-in">
        <a href="/" class="brand">aficionado</a>
        <nav>
          {nav.map((n) => (
            <a href={n.href} class={n.label === current ? 'on' : undefined}>{n.label}</a>
          ))}
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="foot">
      <div class="wrap">
        <p>Division of Global Sports Industry, Hankuk University of Foreign Studies<br />
        한국외국어대학교 글로벌스포츠산업학부</p>
        <p>E: {links.emailWork} · {links.emailPersonal}</p>
        <p class="c">© {new Date().getFullYear()} Seo Hyung Seok. All rights reserved.</p>
      </div>
    </footer>
  </body>
</html>

<style>
  .bar {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--bar);
    color: #fff;
  }
  .bar-in {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    height: 56px;
  }
  .brand {
    font-weight: 700;
    font-size: 1.15rem;
    text-decoration: none;
    white-space: nowrap;
  }
  nav { display: flex; gap: 1.6rem; overflow-x: auto; scrollbar-width: none; }
  nav a {
    color: #d0d0d0;
    text-decoration: none;
    font-size: 0.92rem;
    white-space: nowrap;
  }
  nav a:hover, nav a.on { color: #fff; }
  nav a.on { font-weight: 700; }

  .foot {
    margin-top: var(--space-5);
    padding: var(--space-3) 0;
    font-size: 0.82rem;
    color: var(--muted);
    line-height: 1.6;
  }
  .foot p { margin: 0 0 0.4rem; }
  .foot .c { margin-top: var(--space-2); }

  @media (max-width: 760px) {
    .bar-in { height: auto; flex-direction: column; align-items: flex-start; gap: 0.25rem; padding-top: 0.6rem; padding-bottom: 0.6rem; }
    nav { gap: 1.1rem; width: 100%; }
  }
</style>
