---
import { journey } from '../data/site';
---
<div class="strip" tabindex="0" aria-label="Journey photos">
  {journey.map((j) => (
    <figure>
      <a href={j.src} target="_blank" rel="noopener">
        <img src={j.src} alt={j.en} loading="lazy" />
      </a>
      <figcaption>
        <span class="y">{j.year}</span>
        <span>{j.en}</span>
        {j.ko !== j.en && <span class="ko">{j.ko}</span>}
      </figcaption>
    </figure>
  ))}
</div>

<style>
  .strip {
    display: flex;
    gap: 1rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding: var(--space-3) 0 var(--space-2);
    scrollbar-width: thin;
  }
  figure { margin: 0; flex: 0 0 auto; scroll-snap-align: start; width: min-content; }
  img {
    display: block;
    height: 260px;
    width: auto;
    max-width: 400px;
    object-fit: cover;
    background: var(--line);
  }
  figcaption {
    display: flex;
    flex-direction: column;
    margin-top: 0.5rem;
    min-width: 130px;
    font-size: 0.8rem;
    line-height: 1.45;
    color: var(--muted);
  }
  .y { color: var(--navy); font-weight: 700; }
  .ko { color: #8a8a8a; }
</style>
