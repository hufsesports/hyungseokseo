---
import Base from '../../layouts/Base.astro';
import Band from '../../components/Band.astro';
import Hero from '../../components/Hero.astro';
import { teaching as t } from '../../data/teaching';
---
<Base current="Teaching" title="Teaching — Seo Hyung Seok (Henry Seo)" description={t.intro}>
  <Hero title={t.title} sub={t.tagline} compact />

  <Band title="Course Map">
    <p class="center">{t.intro}</p>
    <p class="center muted">{t.approach}</p>
    <div class="cols-3 stages">
      {t.stages.map((s) => (
        <div>
          <p class="no">{s.no}</p>
          <h3>{s.title}</h3>
          <p>{s.body}</p>
        </div>
      ))}
    </div>
  </Band>

  {t.groups.map((g) => (
    <Band title={g.title}>
      <div class="cols-2 courses">
        {g.courses.map((c) => (
          <article>
            <h3>{c.name}</h3>
            <p class="tags">{c.tags.join(' · ')}</p>
            <p>{c.body}</p>
            <ul class="sq">{c.outcomes.map((o) => <li>{o}</li>)}</ul>
            {c.link && <a class="more" href={c.link.href}>{c.link.label} →</a>}
          </article>
        ))}
      </div>
    </Band>
  ))}
</Base>

<style>
  .center { text-align: center; max-width: 760px; margin: 0 auto 1rem; }
  .muted { color: var(--muted); }
  .stages { margin-top: var(--space-4); text-align: center; }
  .stages .no { margin: 0; color: var(--navy); font-weight: 700; }
  .stages h3 { margin: 0.25rem 0 0.5rem; font-size: 1.1rem; }
  .stages p { margin: 0; color: var(--muted); font-size: 0.95rem; }
  .courses { row-gap: var(--space-4); }
  article h3 { margin: 0; font-size: 1.15rem; font-weight: 700; }
  article p { margin: 0 0 1rem; }
  .tags { margin: 0.15rem 0 0.9rem !important; color: var(--navy); font-size: 0.85rem; font-weight: 500; }
  .sq { color: var(--muted); font-size: 0.93rem; }
  .more {
    display: inline-block;
    margin-top: 1rem;
    color: var(--navy);
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    border-bottom: 1px solid currentColor;
  }
</style>
